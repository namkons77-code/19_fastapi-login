# Supabase Database URL (PostgreSQL 17 connection string with psycopg3)
DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Project API URL & Public Anon Key
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="<your-supabase-anon-key>"

